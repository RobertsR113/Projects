<Window x:Class="Casino.Games.Slots"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Casino.Games"
        mc:Ignorable="d"
        Title="Slots" Height="500" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Games/SlotsMain.png"/>
        </Grid.Background>
        <Image Opacity="0" Name="A" Margin="107,79,536,170" Source="/Pictures/Slots/A.png" Stretch="Fill"/>
        <Image Opacity="0" Name="B" Margin="107,79,536,170" Source="/Pictures/Slots/B.png" Stretch="Fill" RenderTransformOrigin="-0.334,-0.149"/>
        <Image Opacity="0" Name="C" Margin="107,79,536,170" Source="/Pictures/Slots/C.png" Stretch="Fill"/>
        <Image Opacity="0" Name="C1" Margin="302,79,342,170" Source="/Pictures/Slots/C.png" Stretch="Fill"/>
        <Image Opacity="0" Name="B1" Margin="302,79,341,170" Source="/Pictures/Slots/B.png" Stretch="Fill" RenderTransformOrigin="-0.334,-0.149"/>
        <Image Opacity="0" Name="A1" Margin="306,79,337,170" Source="/Pictures/Slots/A.png" Stretch="Fill"/>
        <Image Opacity="0" Name="C2" Margin="506,79,138,170" Source="/Pictures/Slots/C.png" Stretch="Fill"/>
        <Image Opacity="0" Name="B2" Margin="506,79,137,170" Source="/Pictures/Slots/B.png" Stretch="Fill" RenderTransformOrigin="-0.334,-0.149"/>
        <Image Opacity="0" Name="A2" Margin="510,79,133,170" Source="/Pictures/Slots/A.png" Stretch="Fill"/>
        <Image Opacity="0" Name="D" Margin="120,99,548,190" Source="/Pictures/Slots/D.png" Stretch="Fill"/>
        <Image Opacity="0" Name="D1" Margin="326,99,342,190" Source="/Pictures/Slots/D.png" Stretch="Fill"/>
        <Image Opacity="0" Name="D2" Margin="522,99,146,190" Source="/Pictures/Slots/D.png" Stretch="Fill"/>
        <Image Opacity="0" Name="E" Margin="107,79,536,170" Source="/Pictures/Slots/Jackpot.png" Stretch="Fill"/>
        <Image Opacity="0" Name="E1" Margin="306,79,337,170" Source="/Pictures/Slots/Jackpot.png" Stretch="Fill"/>
        <Image Opacity="0" Name="E2" Margin="506,79,137,170" Source="/Pictures/Slots/Jackpot.png" Stretch="Fill"/>
        <Image Name="Down" Opacity="0" Margin="680,10,32,47" Source="/Pictures/Slots/LeverDown.png" Stretch="Fill"/>
        <Image MouseLeftButtonDown="onSpinClick" Name="Up" Margin="680,10,32,47" Source="/Pictures/Slots/LeverUp.png" Stretch="Fill"/>
        <Label Name="won" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="107,10,0,0" VerticalAlignment="Top" Width="545" Height="50" FontSize="40" FontWeight="Bold" FontFamily="Times New Roman" Foreground="#FFFDFF00"/>
        <TextBox Name="betAmount" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="186,418,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="272" Height="28" FontSize="20" FontWeight="Bold" BorderBrush="Black">
            <TextBox.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF946363"/>
                    <GradientStop Color="#FFFFF7F7" Offset="1"/>
                </LinearGradientBrush>
            </TextBox.Foreground>
            <TextBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.8">
                    <GradientStop Color="#FF370B0B"/>
                    <GradientStop Color="#FFFD2F2F" Offset="1"/>
                </LinearGradientBrush>
            </TextBox.Background>
        </TextBox>
        <Label Name="betAmountLabel" Content="Bet amount:" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="30,406,0,0" VerticalAlignment="Top" Width="151" Height="50" FontSize="26" FontWeight="Bold" FontFamily="Times New Roman">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF8463FF"/>
                    <GradientStop Color="#FFF51717" Offset="1"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Label Name="messageDisplay" Opacity="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="0,351,0,0" VerticalAlignment="Top" Width="704" Height="50" FontSize="28" FontWeight="Bold" FontFamily="Times New Roman" Content="">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.7">
                    <GradientStop Color="#FF4E3F0B"/>
                    <GradientStop Color="#FF11C714" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF05C7B0"/>
                    <GradientStop Color="#FFCBFF44" Offset="1"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Button Content="Exit" HorizontalAlignment="Left" Margin="658,396,0,0" VerticalAlignment="Top" Height="60" Width="110" Click="onExitClick" FontSize="30" FontWeight="Bold" Opacity="0.9">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button Content="Enter" Name="enterBetButton" HorizontalAlignment="Left" Margin="463,412,0,0" VerticalAlignment="Top" Height="38" Width="96" Click="enterBetClick" FontSize="25" FontWeight="Bold" Opacity="0.9">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
    </Grid>
</Window>
