<Window x:Class="Casino.MainScreens.GamesScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Casino.MainScreens"
        mc:Ignorable="d"
        Title="GamesScreen"  Height="500" Width="600">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/MainScreens/GameScreen.png"/>
        </Grid.Background>
        <Button Content="Roulette" HorizontalAlignment="Left" Margin="80,298,0,0" VerticalAlignment="Top" Height="60" Width="110" Click="onRouletteClick" FontSize="20" FontWeight="Bold" Opacity="0.9" BorderBrush="#FF291616">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button Content="Slots" HorizontalAlignment="Left" Margin="400,298,0,0" VerticalAlignment="Top" Height="60" Width="110" Click="onSlotsClick" FontSize="20" FontWeight="Bold" Opacity="0.9" BorderBrush="#FF291616">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button Content="Blackjack" HorizontalAlignment="Left" Margin="240,298,0,0" VerticalAlignment="Top" Height="60" Width="110" Click="onBlackjackClick" FontSize="20" FontWeight="Bold" Opacity="0.9" BorderBrush="#FF291616">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <TextBlock x:Name="displayStats" HorizontalAlignment="Center" Margin="0,110,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="138" Width="368" FontWeight="Bold" FontSize="24" FontFamily="Times New Roman">
            <TextBlock.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Background>
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFABABAB"/>
                    <GradientStop Color="Red" Offset="0.993"/>
                </LinearGradientBrush>
            </TextBlock.Foreground></TextBlock>
        <Label Name="displayName" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="600" Height="46" FontSize="36" FontWeight="Bold" FontFamily="Times New Roman" Content="">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC2C2"/>
                    <GradientStop Color="#FFDAFF00" Offset="1"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Label Name="displayPoints" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="0,62,0,0" VerticalAlignment="Top" Width="379" Height="48" FontSize="30" FontWeight="Bold" FontFamily="Times New Roman" Content="">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
            <Label.Foreground>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </RadialGradientBrush>
            </Label.Foreground>
        </Label>
        <Button Content="Exit" HorizontalAlignment="Left" Margin="240,406,0,0" VerticalAlignment="Top" Height="42" Width="110" Click="onExitClick" FontSize="20" FontWeight="Bold" Opacity="0.9" BorderBrush="#FF291616">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>

    </Grid>
</Window>
