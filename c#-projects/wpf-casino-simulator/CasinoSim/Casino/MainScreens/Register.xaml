<Window x:Class="Casino.MainScreens.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Casino.MainScreens"
        mc:Ignorable="d"
            Title="Register" Height="450" Width="400">
    <Grid Margin="0,0,0,1">
        <Grid.Background>
            <ImageBrush ImageSource="/MainScreens/Register.png"/>
        </Grid.Background>
        <TextBox Name="userNameField" HorizontalAlignment="Center" VerticalContentAlignment="Center" Margin="0,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="50" FontSize="24" FontWeight="Bold" Foreground="#FFA6E0D9" BorderBrush="#FF291616">
            <TextBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.8">
                    <GradientStop Color="#FFB36B6B" Offset="0"/>
                    <GradientStop Color="#FFF36C43" Offset="1"/>
                </LinearGradientBrush>
            </TextBox.Background>
        </TextBox>
        <PasswordBox Name="passwordField" HorizontalAlignment="Center" VerticalContentAlignment="Center" Margin="0,140,0,0" VerticalAlignment="Top" Width="300" Height="50" FontSize="24" FontWeight="Bold" Foreground="#FFAEF2F3" BorderBrush="#FF291616">
            <PasswordBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.8">
                    <GradientStop Color="#FFB36565"/>
                    <GradientStop Color="#FFD06E51" Offset="0.987"/>
                </LinearGradientBrush>
            </PasswordBox.Background>
        </PasswordBox>
        <Label HorizontalAlignment="Left" Margin="42,106,0,0" VerticalAlignment="Top" Width="117" Height="32" Content="Password:" FontSize="24" FontWeight="Bold" FontFamily="Times New Roman">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFF2424" Offset="0.187"/>
                    <GradientStop Color="#FFFF8117" Offset="0.763"/>
                </LinearGradientBrush>
            </Label.Foreground>
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
        </Label>
        <Label HorizontalAlignment="Left" Margin="42,6,0,0" VerticalAlignment="Top" Width="117" Height="32" Content="Username:" FontSize="24" FontWeight="Bold" FontFamily="Times New Roman">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFA92424" Offset="0.407"/>
                    <GradientStop Color="#FFFF5200" Offset="0.64"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Button Content="Cancel" HorizontalAlignment="Left" Margin="250,350,0,0" VerticalAlignment="Top" Height="50" Width="100" Click="onCancelClick" FontSize="20" FontWeight="Bold" BorderBrush="#FF291616">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button Content="Register" HorizontalAlignment="Left" Margin="50,350,0,0" VerticalAlignment="Top" Height="50" Width="100" Click="onRegisterClick" FontWeight="Bold" FontSize="20" BorderBrush="#FF291616">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9" Offset="0"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <PasswordBox x:Name="passwordField2" HorizontalAlignment="Center" VerticalContentAlignment="Center" Margin="0,240,0,0" VerticalAlignment="Top" Width="300" Height="50" FontSize="24" FontWeight="Bold" Foreground="#FFA3E2E4" BorderBrush="#FF291616">
            <PasswordBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.8">
                    <GradientStop Color="#FFB36B6B"/>
                    <GradientStop Color="#FFCC6343" Offset="1"/>
                </LinearGradientBrush>
            </PasswordBox.Background>
        </PasswordBox>
        <Label HorizontalAlignment="Left" Margin="42,206,0,0" VerticalAlignment="Top" Width="200" Height="32" Content="Repeat Password:" FontSize="24" FontWeight="Bold" FontFamily="Times New Roman">
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFF11F1F"/>
                    <GradientStop Color="#FFFFD619" Offset="0.76"/>
                </LinearGradientBrush>
            </Label.Foreground>
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
        </Label>
        <TextBlock Opacity="0" Name="messageDisplay" Margin="0,308,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="380" Height="25" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" RenderTransformOrigin="-0.284,0.19" FontFamily="Times New Roman">
            <TextBlock.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.7">
                    <GradientStop Color="#FF6D5500"/>
                    <GradientStop Color="#FFCA1313" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Background>
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFF895B"/>
                    <GradientStop Color="#FFF1FF00" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
    </Grid>
</Window>
