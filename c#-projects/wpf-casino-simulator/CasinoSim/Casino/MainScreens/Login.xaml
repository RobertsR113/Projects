<Window x:Class="Casino.MainScreens.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Casino.MainScreens"
        mc:Ignorable="d"
        Title="Login" Height="350" Width="400">
    <Window.Background>
        <ImageBrush/>
    </Window.Background>
    <Grid Margin="0,0,0,1">
        <Grid.Background>
            <ImageBrush ImageSource="/MainScreens/Login.png"/>
        </Grid.Background>
        <TextBox Name="userNameField" HorizontalAlignment="Center" VerticalContentAlignment="Center" Margin="0,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Height="50" FontSize="24" FontWeight="Bold" Opacity="0.8" Foreground="#FFDBFDF3" BorderBrush="#FF291616">
            <TextBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.8">
                    <GradientStop Color="#FFB33636" Offset="0"/>
                    <GradientStop Color="#FFDE6F56" Offset="1"/>
                </LinearGradientBrush>
            </TextBox.Background>
        </TextBox>
        <Label Opacity="0" Name="messageDisplay" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="0,206,0,0" VerticalAlignment="Top" Width="362" Height="33" FontSize="20" FontWeight="Bold" FontFamily="Times New Roman" Content="">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.7">
                    <GradientStop Color="#FF6D5500"/>
                    <GradientStop Color="#FFCA1313" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFF1FF00" Offset="1"/>
                    <GradientStop Color="#FFFF895B" Offset="0"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Button Content="Register" HorizontalAlignment="Left" Margin="250,244,0,0" VerticalAlignment="Top" Height="50" Width="100" Click="onRegisterClick" FontSize="20" FontWeight="Bold" Opacity="0.9" BorderBrush="#FF291616">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button Content="Login" HorizontalAlignment="Left" Margin="50,244,0,0" VerticalAlignment="Top" Height="50" Width="100" Click="onLoginClick" FontWeight="Bold" FontSize="20" Opacity="0.9" BorderBrush="#FF291616">
            <Button.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFC9C9" Offset="0"/>
                    <GradientStop Color="#FFDA2323" Offset="1"/>
                </LinearGradientBrush>
            </Button.Foreground>
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <PasswordBox Name="passwordField" HorizontalAlignment="Center" VerticalContentAlignment="Center" Margin="0,143,0,0" VerticalAlignment="Top" Width="300" Height="50" FontSize="24" FontWeight="Bold" Opacity="0.8" Foreground="#FFBAECED" BorderBrush="#FF291616">
            <PasswordBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.9">
                    <GradientStop Color="#FFB33636"/>
                    <GradientStop Color="#FFDE6F56" Offset="1"/>
                </LinearGradientBrush>
            </PasswordBox.Background>
        </PasswordBox>
        <Label HorizontalAlignment="Left" Margin="42,108,0,0" VerticalAlignment="Top" Width="116" Height="33" Content="Password:" FontSize="24" FontWeight="Bold" FontFamily="Times New Roman">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Red"/>
                    <GradientStop Color="#FFE49A17" Offset="1"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
        <Label HorizontalAlignment="Left" Margin="42,7,0,0" VerticalAlignment="Top" Width="128" Height="31" Content="Username:" FontSize="24" FontWeight="Bold" FontFamily="Sitka Subheading">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="1">
                    <GradientStop Color="#FF4A2C2C"/>
                    <GradientStop Color="#FF291616" Offset="1"/>
                </LinearGradientBrush>
            </Label.Background>
            <Label.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFD80B8E"/>
                    <GradientStop Color="#FFC8850E" Offset="0.963"/>
                </LinearGradientBrush>
            </Label.Foreground>
        </Label>
    </Grid>
</Window>
